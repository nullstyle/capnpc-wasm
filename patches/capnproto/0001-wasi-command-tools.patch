diff --git a/c++/src/kj/main.h b/c++/src/kj/main.h
--- a/c++/src/kj/main.h
+++ b/c++/src/kj/main.h
@@ -175,12 +175,28 @@
 //
 // Most users will use the KJ_MAIN() macro rather than call this function directly.
 
+#if __wasi__
+// Under Wasm exception handling nothing calls std::terminate() for an exception that escapes
+// main(); the host reports an opaque trap. Construct the main object inside runMainAndExit()'s
+// exception envelope, so a failure there (for example, no directory preopened at "/") is reported
+// as "*** Uncaught exception ***" with exit status 1, like a failure inside the main function.
+#define KJ_MAIN(MainClass) \
+  int main(int argc, char* argv[]) { \
+    ::kj::TopLevelProcessContext context(argv[0]); \
+    ::kj::Maybe<MainClass> mainObject; \
+    return ::kj::runMainAndExit(context, \
+        [&](::kj::StringPtr programName, ::kj::ArrayPtr<const ::kj::StringPtr> params) { \
+          mainObject.emplace(context).getMain()(programName, params); \
+        }, argc, argv); \
+  }
+#else
 #define KJ_MAIN(MainClass) \
   int main(int argc, char* argv[]) { \
     ::kj::TopLevelProcessContext context(argv[0]); \
     MainClass mainObject(context); \
     return ::kj::runMainAndExit(context, mainObject.getMain(), argc, argv); \
   }
+#endif
 // Convenience macro for declaring a main function based on the given class.  The class must have
 // a constructor that accepts a ProcessContext& and a method getMain() which returns
 // kj::MainFunc (probably building it using a MainBuilder).
