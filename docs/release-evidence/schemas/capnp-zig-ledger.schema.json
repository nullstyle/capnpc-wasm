{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Superseded capnp-zig nightly-confidence ledger",
  "description": "The hand-kept ledger that measured nullstyle/capnp-zig's own scheduled Nightly on capnp-zig main, frozen at its last update (commit b8d8e3f, 2026-09-09). Decision D5 = A replaced it with nightly-confidence.json.",
  "x-fileNamePattern": "^capnp-zig-nightly-confidence\\.json$",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "requiredConsecutiveScheduledRuns",
    "currentConsecutiveScheduledRuns",
    "nativeRevision",
    "acceptedWasmRevision",
    "acceptedDenoRevision",
    "initialEvidence",
    "workflow",
    "earliestEligibleScheduledDateUtc",
    "followupLocalTime",
    "followupTimeZone",
    "cycles",
    "rules",
    "publicationAuthorized",
    "lastAuditedScheduledDateUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "phase": { "const": "scheduled_nightly_confidence" },
    "requiredConsecutiveScheduledRuns": { "type": "integer", "minimum": 1 },
    "currentConsecutiveScheduledRuns": { "type": "integer", "minimum": 0 },
    "nativeRevision": { "$ref": "#/$defs/commit" },
    "acceptedWasmRevision": { "$ref": "#/$defs/commit" },
    "acceptedDenoRevision": { "$ref": "#/$defs/commit" },
    "initialEvidence": { "type": "string", "x-evidenceFile": true },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "requiredEvent", "scheduledTimeUtc"],
      "properties": {
        "repository": { "const": "nullstyle/capnp-zig" },
        "path": { "const": ".github/workflows/nightly.yml" },
        "requiredEvent": { "const": "schedule" },
        "scheduledTimeUtc": { "$ref": "#/$defs/timeOfDay" }
      }
    },
    "earliestEligibleScheduledDateUtc": { "$ref": "#/$defs/date" },
    "followupLocalTime": { "$ref": "#/$defs/timeOfDay" },
    "followupTimeZone": { "type": "string", "minLength": 1 },
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheduledDateUtc",
          "runId",
          "runUrl",
          "event",
          "nativeRevision",
          "conclusion",
          "qualifies",
          "consecutiveScheduledRuns",
          "hostedEvidence",
          "fuzzEvidence",
          "fuzzTargets",
          "fuzzExecutions",
          "minimumMeasuredIterations",
          "requiredIterationsPerTarget",
          "artifactId",
          "artifactSha256"
        ],
        "properties": {
          "scheduledDateUtc": { "$ref": "#/$defs/date" },
          "runId": { "type": "integer", "minimum": 1 },
          "runUrl": { "$ref": "#/$defs/runUrl" },
          "event": { "const": "schedule" },
          "nativeRevision": { "$ref": "#/$defs/commit" },
          "conclusion": { "$ref": "#/$defs/conclusion" },
          "qualifies": { "type": "boolean" },
          "consecutiveScheduledRuns": { "type": "integer", "minimum": 0 },
          "hostedEvidence": { "type": "string", "x-evidenceFile": true },
          "fuzzEvidence": { "type": "string", "x-evidenceFile": true },
          "fuzzTargets": { "type": "integer", "minimum": 0 },
          "fuzzExecutions": { "type": "integer", "minimum": 0 },
          "minimumMeasuredIterations": { "type": "integer", "minimum": 0 },
          "requiredIterationsPerTarget": { "type": "integer", "minimum": 0 },
          "artifactId": { "type": "integer", "minimum": 1 },
          "artifactSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "publicationAuthorized": { "type": "boolean" },
    "lastAuditedScheduledDateUtc": { "$ref": "#/$defs/date" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "timeOfDay": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
    "runUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[0-9]+$"
    },
    "conclusion": {
      "enum": [
        "success",
        "failure",
        "cancelled",
        "skipped",
        "timed_out",
        "neutral",
        "action_required",
        "stale",
        "startup_failure"
      ]
    }
  }
}
