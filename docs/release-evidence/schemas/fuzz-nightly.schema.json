{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scheduled capnp-zig Nightly fuzz audit",
  "description": "The per-target fuzz receipts of one scheduled nullstyle/capnp-zig Nightly run, audited against the exact source revision and the requested iteration floor for the superseded capnp-zig ledger.",
  "x-fileNamePattern": "^nightly-[0-9]{4}-[0-9]{2}-[0-9]{2}-fuzz\\.json$",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "qualifies_as_scheduled_daily_cycle",
    "scheduled_date_utc",
    "source_sha256",
    "artifact_id",
    "artifact_name",
    "artifact_sha256",
    "raw_manifest_sha256",
    "raw_summary_sha256",
    "raw_job_log_sha256",
    "harness_self_checks",
    "audit",
    "target_count",
    "total_executions",
    "jobs",
    "targets"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "attempt",
        "workflow_path",
        "conclusion",
        "createdAt",
        "event",
        "headSha",
        "updatedAt",
        "url"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "workflow_path": { "const": ".github/workflows/nightly.yml" },
        "conclusion": { "$ref": "#/$defs/conclusion" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "event": { "const": "schedule" },
        "headSha": { "$ref": "#/$defs/commit" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "url": { "$ref": "#/$defs/runUrl" }
      }
    },
    "qualifies_as_scheduled_daily_cycle": { "type": "boolean" },
    "scheduled_date_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_sha256": {
      "description": "Digest of each source file the audit read, keyed by path.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "artifact_id": { "type": "integer", "minimum": 1 },
    "artifact_name": { "type": "string", "minLength": 1 },
    "artifact_sha256": { "$ref": "#/$defs/sha256" },
    "raw_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "raw_summary_sha256": { "$ref": "#/$defs/sha256" },
    "raw_job_log_sha256": { "$ref": "#/$defs/sha256" },
    "harness_self_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "expected", "names", "job_id"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "expected": { "type": "integer", "minimum": 0 },
        "names": { "type": "array", "items": { "type": "string" } },
        "job_id": { "type": "integer", "minimum": 1 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_declarations",
        "manifest_targets",
        "individual_receipts",
        "manifest_source_filter_report_match",
        "missing_or_extra_receipts",
        "oracle_failures",
        "all_processes_exited_zero",
        "minimum_measured_iterations",
        "maximum_measured_iterations",
        "requested_iterations_floor",
        "all_requested_iteration_floors_satisfied",
        "platform"
      ],
      "properties": {
        "source_declarations": { "type": "integer", "minimum": 0 },
        "manifest_targets": { "type": "integer", "minimum": 0 },
        "individual_receipts": { "type": "integer", "minimum": 0 },
        "manifest_source_filter_report_match": { "type": "boolean" },
        "missing_or_extra_receipts": { "type": "integer", "minimum": 0 },
        "oracle_failures": { "type": "integer", "minimum": 0 },
        "all_processes_exited_zero": { "type": "boolean" },
        "minimum_measured_iterations": { "type": "integer", "minimum": 0 },
        "maximum_measured_iterations": { "type": "integer", "minimum": 0 },
        "requested_iterations_floor": { "type": "integer", "minimum": 0 },
        "all_requested_iteration_floors_satisfied": { "type": "boolean" },
        "platform": { "$ref": "#/$defs/platform" }
      }
    },
    "target_count": { "type": "integer", "minimum": 0 },
    "total_executions": { "type": "integer", "minimum": 0 },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "html_url",
          "status",
          "conclusion",
          "started_at",
          "completed_at"
        ],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "html_url": { "$ref": "#/$defs/jobUrl" },
          "status": { "const": "completed" },
          "conclusion": { "$ref": "#/$defs/conclusion" },
          "started_at": { "$ref": "#/$defs/timestamp" },
          "completed_at": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "source_sha256",
          "target",
          "report_name",
          "argv",
          "requested_iterations",
          "seed",
          "report",
          "process_term",
          "raw_receipt_sha256",
          "stdout_sha256",
          "stderr_sha256"
        ],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "source_sha256": { "$ref": "#/$defs/sha256" },
          "target": { "type": "string", "minLength": 1 },
          "report_name": { "type": "string", "minLength": 1 },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "requested_iterations": { "type": "integer", "minimum": 1 },
          "seed": { "type": "integer", "minimum": 0 },
          "report": { "$ref": "#/$defs/report" },
          "process_term": { "$ref": "#/$defs/processTerm" },
          "raw_receipt_sha256": { "$ref": "#/$defs/sha256" },
          "stdout_sha256": { "$ref": "#/$defs/sha256" },
          "stderr_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "runUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[0-9]+$"
    },
    "jobUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[0-9]+/job/[0-9]+$"
    },
    "conclusion": {
      "enum": [
        "success",
        "failure",
        "cancelled",
        "skipped",
        "timed_out",
        "neutral",
        "action_required",
        "stale",
        "startup_failure"
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "zig_version"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "zig_version": { "type": "string", "minLength": 1 }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "iterations"],
      "properties": {
        "before": { "type": "integer", "minimum": 0 },
        "after": { "type": "integer", "minimum": 0 },
        "iterations": { "type": "integer", "minimum": 0 }
      }
    },
    "processTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exited"],
      "properties": { "exited": { "type": "integer" } }
    }
  }
}
