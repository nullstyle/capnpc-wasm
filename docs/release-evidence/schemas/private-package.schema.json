{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private package candidate receipt",
  "description": "A copy of build/test/package-receipt.json from `mise run test:package`, named by the producer commit: the candidate version, source identity, archive digests, the checks that passed, and the digest of every generated file.",
  "x-fileNamePattern": "^[0-9a-f]{7}-private-package\\.json$",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "source",
    "archiveSha256",
    "checks",
    "generated"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "sha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "archiveSha256": { "$ref": "#/$defs/sha256" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "sbomSha256": { "$ref": "#/$defs/sha256" },
    "toolsArchiveSha256": { "$ref": "#/$defs/sha256" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "generated": {
      "description": "Digest of the canonical request and of every generated file, keyed by name.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
